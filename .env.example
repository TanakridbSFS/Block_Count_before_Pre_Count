# Google service account (see README.md "Google Cloud setup")
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key from the service account JSON key file.
# Keep the \n sequences literal (do not replace them with real newlines) —
# the app converts them back at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentsGoHere\n-----END PRIVATE KEY-----\n"

# Record File spreadsheet — the only Google Sheet this app needs.
# https://docs.google.com/spreadsheets/d/<THIS_ID>/edit
RECORD_SHEET_ID=paste-your-record-sheet-id-here

# Sheet tab (bottom-tab) name — change if you named it differently
RECORD_TAB=CountRecord

# How often an open count screen polls for updates from other devices (ms).
# Lower = sees other devices' saves sooner, but uses more Google Sheets API quota.
POLL_INTERVAL_MS=6000
